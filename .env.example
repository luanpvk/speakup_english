# MongoDB local (Docker: npm run db:up)
MONGODB_URI=mongodb://127.0.0.1:27017/speakup-english

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=substitua-por-secret-access-min-32-chars
JWT_REFRESH_SECRET=substitua-por-secret-refresh-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: email provider for password reset (future)
# RESEND_API_KEY=
